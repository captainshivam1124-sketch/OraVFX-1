NODE_ENV=production
PORT=4173
# Set this to the persistent directory provided by your host.
DATA_DIR=/var/lib/oravfx/data
# Optional; defaults to DATA_DIR/uploads.
UPLOADS_DIR=/var/lib/oravfx/data/uploads
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAX_REQUEST_BYTES=5000000
TRUST_PROXY=1
